{
  "prophet": {
    "algorithm": "Prophet",
    "version": "1.1.4",
    "purpose": "Prévision demande en eau à H+7 jours",
    "features": [
      "historical_demand",
      "temperature",
      "is_market_day",
      "lag_24h",
      "lag_168h",
      "rolling_mean_24h",
      "rolling_mean_168h",
      "hour",
      "dayofweek"
    ],
    "hyperparameters": {
      "changepoint_prior_scale": 0.05,
      "seasonality_prior_scale": 10,
      "seasonality_mode": "multiplicative",
      "daily_seasonality": true,
      "weekly_seasonality": true,
      "yearly_seasonality": true
    },
    "performance": {
      "MAPE": "12.10%",
      "MAE": "Average 164 m³/h",
      "RMSE": "Average 189 m³/h"
    }
  },
  "optimization": {
    "algorithm": "Linear Programming (PuLP)",
    "version": "2.7.0",
    "purpose": "Optimisation planning pompage",
    "objective": "Minimiser coût électricité",
    "constraints": [
      "reservoir_level >= 20%",
      "reservoir_level <= 95%",
      "demand_satisfaction == 100%",
      "pumping <= max_capacity"
    ],
    "solver": "CBC",
    "performance": {
      "savings_percent": "42-48%",
      "execution_time": "<5 seconds"
    }
  },
  "clustering": {
    "algorithm": "K-Means",
    "version": "scikit-learn 1.3.0",
    "purpose": "Priorisation sites énergivores",
    "features": [
      "power_consumption_kw",
      "specific_consumption",
      "efficiency"
    ],
    "hyperparameters": {
      "n_clusters": 3,
      "random_state": 42,
      "max_iter": 300
    },
    "labels": {
      "0": "CRITIQUE_intervention_urgente",
      "1": "MOYEN_optimisation_recommandée",
      "2": "BON_performance_optimale"
    }
  },
  "anomaly_detection": {
    "algorithm": "Isolation Forest",
    "version": "scikit-learn 1.3.0",
    "purpose": "Détection fuites et inefficacités",
    "features": [
      "power_consumption_kw",
      "efficiency",
      "specific_consumption"
    ],
    "hyperparameters": {
      "contamination": 0.05,
      "random_state": 42,
      "n_estimators": 100
    },
    "performance": {
      "anomalies_detected": 129,
      "detection_rate": "0.49%",
      "types": {
        "power_spike": 62,
        "potential_leak": 30,
        "efficiency_drop": 23,
        "unknown": 14
      }
    }
  }
